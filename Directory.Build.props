<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <FaceNowBuildRoot Condition="'$(FaceNowBuildRoot)' == ''">$(MSBuildThisFileDirectory).build/dotnet/</FaceNowBuildRoot>
    <XmaxDotNetBuildRoot Condition="'$(XmaxDotNetBuildRoot)' == ''">$(FaceNowBuildRoot)sdk/</XmaxDotNetBuildRoot>
    <BaseOutputPath>$(FaceNowBuildRoot)bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(FaceNowBuildRoot)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <XmaxSdkRoot Condition="'$(XmaxSdkRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../XmaxSDK'))</XmaxSdkRoot>
  </PropertyGroup>
</Project>
