<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FaceNow</AssemblyName>
    <RootNamespace>FaceNow.App</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/FaceNow.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(FaceNowMediaDirectory)/FaceNow.FrameEffects.dll" Link="FaceNow.FrameEffects.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(FaceNowMediaDirectory)/FaceNow.FrameEffects.dll')" />
    <Content Include="../../assets/FaceNow.png" Link="Assets/FaceNow.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/FaceNowBrandMark.png" Link="Assets/FaceNowBrandMark.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/Login/**/*" Link="Assets/Login/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/FaceNow.ico" Link="Assets/FaceNow.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" PrivateAssets="all" />
    <ProjectReference Include="../FaceNow.Windows/FaceNow.Windows.csproj" />
    <ProjectReference Include="$(XmaxSdkRoot)/Sources/XmaxSDK.WinUI/XmaxSDK.WinUI.csproj" />
    <Content Include="$(XmaxSdkRoot)/Examples/XLab/assets/DMSans.ttf" Link="Assets/DMSans.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(XmaxSdkRoot)/Examples/XLab/assets/DMSans-OFL.txt" Link="DMSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
