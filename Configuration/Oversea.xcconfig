// Overseas application identity and condition used to select edition-specific behavior.
#include "Base.xcconfig"

PRODUCT_NAME = FaceNow
PRODUCT_BUNDLE_IDENTIFIER = com.xmax.meeting.camera.oversea
FACENOW_EDITION = oversea
FACENOW_LANGUAGE = en
FACENOW_CAMERA_USAGE_DESCRIPTION = FaceNow uses your camera to generate video for your virtual camera.
FACENOW_MICROPHONE_USAGE_DESCRIPTION = FaceNow uses your microphone when you enable microphone capture.
FACENOW_SYSTEM_EXTENSION_USAGE_DESCRIPTION = Enable FaceNow - Xmax Virtual Camera to use generated video in meeting apps.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) OVERSEA
