    "about.latency.detail": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end latency is measured in hundreds of milliseconds, ensuring that updates to generation conditions and interaction controls are reflected instantly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端到端延迟为百毫秒级，首帧生成与效果切换均可实现秒级响应，响应速度显著优于同类方案。"
          }
        }
      }
    },
    "about.latency.metric": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "~200 ms"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 200 毫秒"
          }
        }
      }
    },
    "about.latency.title": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Latency"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低延迟"
          }
        }
      }
    },
    "about.model_introduction": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xmax X2.1 is a world-leading general-purpose model for real-time interaction and video editing. A single model supports character swapping, virtual try-on, free-form editing, touch interaction, and interactions between virtual elements and the physical world. It generates 1080P video with approximately 200 ms of end-to-end latency and runs on consumer-grade GPUs, reducing reliance on costly data center GPUs. At approximately $0.001667 per second (about $6 per hour), X2.1 delivers these capabilities at a fraction of the cost of comparable solutions, making large-scale commercial deployment economically viable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xmax X2.1 是一款面向实时互动与视频编辑的模型，支持角色替换、虚拟试穿、风格迁移、触控交互等功能。它可以以比竞品便宜数倍到数十倍的成本生成清晰、流畅的视频，为可商用的实时互动应用提供支持。"
          }
        }
      }
    },
    "about.model_title": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet Xmax X2.1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解 Xmax X2.1"
          }
        }
      }
    },
    "about.partnership_detail": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FaceNow brings your new look into video meetings, live streams, and more through a virtual camera. The same technology also powers other commercial experiences, including virtual try-on and interactive applications. If you are exploring a business use case, contact us to discuss a solution together. We can help you shape the experience and provide technical support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 FaceNow 虚拟摄像头，你可以用全新形象参与视频会议、直播等活动。Xmax X2.1 的能力还可用于虚拟试穿、互动应用等更多场景。如果你正在探索相关产品或商业应用，欢迎联系我们，一起讨论需求和落地方案。我们也可以提供体验设计与技术支持。"
          }
        }
      }
    },
    "about.partnership_title": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
