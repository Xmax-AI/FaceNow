    },
    "about.latency.detail": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end latency is measured in hundreds of milliseconds, ensuring that updates to generation conditions and interaction controls are reflected instantly."
          }
        }
      }
    },
