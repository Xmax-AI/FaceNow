    "about.fidelity.detail": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real-time 1080P output preserves fine details and textures, with greater fidelity to the characters, clothing, and style in your reference images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清晰呈现人物、服装与纹理细节，更好地还原参考图中的外观和风格。"
          }
        }
      }
    },
    "about.fidelity.metric": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
