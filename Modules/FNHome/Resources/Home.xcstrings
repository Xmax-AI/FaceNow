    "about.cost.detail": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on consumer-grade GPUs, with costs several to tens of times lower than alternative solutions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持消费级 GPU，降低硬件门槛和运行成本，让大规模部署更容易落地。"
          }
        }
      }
    },
    "about.cost.metric": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
