    },
    "about.model_introduction": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xmax X2.1 is a world-leading general-purpose model for real-time interaction and video editing. A single model supports character swapping, virtual try-on, free-form editing, touch interaction, and interactions between virtual elements and the physical world. It generates 1080P video with approximately 200 ms of end-to-end latency and runs on consumer-grade GPUs, reducing reliance on costly data center GPUs. At approximately $0.001667 per second (about $6 per hour), X2.1 delivers these capabilities at a fraction of the cost of comparable solutions, making large-scale commercial deployment economically viable."
          }
        }
      }
    },
    "about.advantages_title": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built for real-world interaction"
          }
        }
      }
    },
    "about.latency.title": {
      "comment": "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
