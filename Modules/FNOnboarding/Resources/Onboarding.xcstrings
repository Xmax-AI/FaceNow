    "guide.explanation.check_again" : {
      "comment" : "Explains how to repeat discovery without reinstalling the virtual camera.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “Check Again” in the bottom-right corner to recheck the camera. FaceNow will update this page with the result."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右下角的“重新检查”以再次检查摄像头。FaceNow 将在此页面显示检查结果。"
          }
        }
      }
    },
    "guide.explanation.checking" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FaceNow is checking whether Virtual Camera is installed, enabled, and available to video calling apps.\n\nPlease wait. This page will update automatically when the check finishes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FaceNow 正在检查虚拟摄像头是否已安装、已启用，以及是否可供视频通话应用使用。\n\n请稍候，检查完成后此页面会自动更新。"
          }
        }
      }
    },
    "guide.explanation.connect_camera" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure your camera is connected and available, then check again using the button in the bottom-right corner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认摄像头已连接且可用，然后点击右下角的按钮重新检查。"
          }
        }
      }
    },
    "guide.explanation.contact_support" : {
      "comment" : "Virtual-camera setup action, failure, or restart recovery guidance.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “Copy Error Details” in the bottom-right corner and include the details when contacting FaceNow support."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右下角的“复制错误详情”，并在联系 FaceNow 技术支持时提供这些信息。"
          }
        }
      }
    },
    "guide.explanation.enable_extension" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “Open System Settings” in the bottom-right corner, then enable the FaceNow camera extension. Return to FaceNow when you are done."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右下角的“打开系统设置”，启用 FaceNow 相机扩展，完成后返回 FaceNow。"
          }
        }
      }
    },
    "guide.explanation.install" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “%1$@” in the bottom-right corner to let macOS install and enable Virtual Camera. If macOS asks for approval, follow the system dialog."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右下角的“%1$@”，让 macOS 安装并启用虚拟摄像头。如果 macOS 要求批准，请按系统弹窗提示操作。"
          }
        }
      }
    },
    "guide.explanation.manual_removal" : {
      "comment" : "Virtual-camera setup action, failure, or restart recovery guidance.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “Open System Settings” in the bottom-right corner and remove the previous FaceNow camera extension. Follow any macOS request to restart, then reopen FaceNow. Setup will continue after removal is confirmed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右下角的“打开系统设置”，移除旧的 FaceNow 相机扩展。如 macOS 要求重新启动，请按系统提示操作，然后重新打开 FaceNow。确认移除后，设置将继续。"
          }
        }
      }
    },
    "guide.explanation.move_application" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “Show in Finder” to locate FaceNow. Move it to your Applications folder, then reopen it and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击“在访达中显示”以找到 FaceNow。将它移至“应用程序”文件夹，然后重新打开并重试。"
          }
        }
      }
    },
    "guide.explanation.not_installed" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtual Camera has not been installed on this Mac. It sends your FaceNow look to video calling apps as a camera input."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 尚未安装虚拟摄像头。它会将你的 FaceNow 形象作为摄像头输入，传送到视频通话应用中。"
          }
        }
      }
    },
    "guide.explanation.publication_recovery" : {
      "comment" : "Recovery guidance when the enabled virtual camera device is not published.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “Open System Settings” in the bottom-right corner. Under General → Login Items & Extensions → Camera Extensions, turn FaceNow off, then back on. Return to FaceNow to check the connection automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右下角的“打开系统设置”。在“通用 → 登录项与扩展 → 相机扩展”中，将 FaceNow 关闭后重新开启。返回 FaceNow 后会自动检查连接。"
          }
        }
      }
    },
    "guide.explanation.reinstall" : {
      "comment" : "Virtual-camera setup action, failure, or restart recovery guidance.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “Install” in the bottom-right corner. FaceNow will replace the previous camera extension and check that Virtual Camera is available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右下角的“安装”。FaceNow 将替换旧的相机扩展，并检查虚拟摄像头是否可用。"
          }
        }
      }
    },
    "guide.explanation.request_access" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “Allow Camera Access” in the bottom-right corner, then choose Allow in the macOS permission dialog."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右下角的“允许使用摄像头”，然后在 macOS 权限弹窗中选择“允许”。"
          }
        }
      }
    },
    "guide.explanation.restart_application" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “Restart FaceNow” in the bottom-right corner to reopen the app and refresh its camera connection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右下角的“重新启动 FaceNow”，重新打开应用并刷新摄像头连接。"
