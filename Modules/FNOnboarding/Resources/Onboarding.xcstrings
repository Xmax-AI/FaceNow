        }
      }
    },
    "guide.explanation.retry" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “%1$@” in the bottom-right corner to retry the operation. FaceNow will update this page with the result or the next required step."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
