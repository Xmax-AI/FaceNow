    },
    "guide.explanation.video_calls" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %1$@, open the camera settings and choose “%2$@” as your video input.\n\nThis lets the app receive your FaceNow look instead of the original camera feed. If the camera is missing from the list, reopen the video calling app after enabling Virtual Camera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %1$@ 中打开摄像头设置，选择“%2$@”作为视频输入。\n\n这样，该应用会接收你的 FaceNow 形象，而不是原始摄像头画面。如果列表中没有该摄像头，请在启用虚拟摄像头后重新打开视频通话应用。"
          }
        }
      }
    },
    "guide.explanation.waiting" : {
