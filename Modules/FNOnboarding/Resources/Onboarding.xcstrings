    "guide.explanation.version_mismatch" : {
      "comment" : "State explanation and next action shown when onboarding has no corresponding screenshot. Preserve placeholders and product names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installed Virtual Camera belongs to a different FaceNow build. Reinstall it to remove the previous extension and install the version included with this app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装的虚拟摄像头属于其他 FaceNow 构建版本。请重新安装，以移除旧扩展并安装此应用附带的版本。"
