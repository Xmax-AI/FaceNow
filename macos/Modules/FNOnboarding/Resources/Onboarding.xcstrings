{
  "sourceLanguage" : "en",
  "strings" : {
    "guide.virtual_microphone_checking_detail": {
      "comment": "Describes an explicit in-progress microphone device query.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking Virtual Microphone. Please wait..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检测虚拟麦克风，请稍候…"
          }
        }
      }
    },
    "guide.virtual_microphone_checked_pending_detail": {
      "comment": "Confirms that a completed query still found no published device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check complete. macOS still has not detected Virtual Microphone. The driver is installed. Restart your Mac and check again, or set up audio later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测完成，系统仍未识别到虚拟麦克风。驱动已安装，请重启 Mac 后再检测；也可以先跳过音频设置。"
          }
        }
      }
    },
    "guide.virtual_microphone_checked_not_installed_detail": {
      "comment": "Distinguishes a completed negative installation check from an in-progress query.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check complete. The Virtual Microphone driver was not found. Install it first, or set up audio later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测完成，尚未找到虚拟麦克风驱动。请先安装，或选择“稍后设置音频”。"
          }
        }
      }
    },
    "guide.virtual_microphone_check_timed_out_detail": {
      "comment": "Offers retry or deferral when system discovery takes too long.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check timed out, so Virtual Microphone status could not be confirmed. Check again, or set up audio later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测超时，暂时无法确认虚拟麦克风状态。你可以重新检测，或稍后设置音频。"
          }
        }
      }
    },
    "guide.microphone_permission_prompt": {
      "comment": "Describes the supplied microphone-access prompt to assistive technologies.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone permission dialog. Choose Allow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风权限弹窗。请选择“允许”。"
          }
        }
      }
    },
    "guide.audio_setup": {
      "comment": "Groups optional microphone permission and synchronized audio output.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Setup (Optional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频设置（可选）"
          }
        }
      }
    },
    "guide.skip_audio_setup": {
      "comment": "Defers the complete audio setup without leaving the video preparation flow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Up Audio Later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后设置音频"
          }
        }
      }
    },
    "guide.finish_setup": {
      "comment": "Finishes preparation without implying that camera capture has already started.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish Setup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成设置"
          }
        }
      }
    },
    "guide.virtual_microphone_install_detail": {
      "comment": "Explains administrator installation while allowing video use before audio is ready.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the FaceNow audio driver with the macOS installer. Administrator authorization is required. If the device has not appeared after installation, you can use video first and restart your Mac later to finish audio setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 macOS 安装器安装 FaceNow 音频驱动，需要管理员授权。如果安装后设备尚未出现，可以先使用视频功能，稍后重启 Mac 完成音频设置。"
          }
        }
      }
    },
    "guide.virtual_microphone_pending_detail": {
      "comment": "Keeps a deferred audio-driver restart from interrupting video preparation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Virtual Microphone driver is installed but not active yet. You can use video first and restart your Mac later to finish audio setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟麦克风驱动已安装，但尚未生效。你可以先使用视频功能，稍后重启 Mac 完成音频设置。"
          }
        }
      }
    },
    "notice.camera_status_check_failed" : {
      "comment" : "Distinguishes an unavailable status check from an activation failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t check Virtual Camera. Check again, or reopen FaceNow if this continues."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取虚拟摄像头状态。请重新检查；若仍失败，请重新打开 FaceNow。"
          }
        }
      }
    },
    "guide.reinstall_application_title" : {
      "comment" : "Names the recovery for a missing or invalid bundled camera component.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinstall FaceNow"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新安装 FaceNow"
          }
        }
      }
    },
    "guide.move_application_title" : {
      "comment" : "Explains the location prerequisite before offering virtual-camera installation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move FaceNow to Applications"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先将 FaceNow 移至“应用程序”"
          }
        }
      }
    },
    "guide.virtual_microphone" : {
      "comment" : "Names the optional generated-audio output step.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtual Microphone"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟麦克风"
          }
        }
      }
    },
    "guide.setup_virtual_microphone" : {
      "comment" : "Introduces explicit installation and enabling of audio output.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set Up Virtual Microphone"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置虚拟麦克风"
          }
        }
      }
    },
    "guide.virtual_microphone_introduction" : {
      "comment" : "Explains optional synchronized audio output for video calls.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Virtual Microphone to keep audio and video in sync during video calls. You can skip this step and set it up later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启虚拟麦克风，让视频通话的声音与画面保持同步。你也可以跳过，稍后再设置。"
          }
        }
      }
    },
    "guide.virtual_microphone_enable_detail" : {
      "comment" : "Explains enabling an already published virtual input.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device is available. Click Enable to output synchronized audio through %1$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备已可用。点击“启用”，通过 %1$@ 输出与画面同步的声音。"
          }
        }
      }
    },
    "guide.virtual_microphone_step_ready" : {
      "comment" : "Confirms device readiness without claiming audio capture or generation has started.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtual Microphone is enabled. Continue setup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟麦克风已启用。继续完成设置。"
          }
        }
      }
    },
    "guide.video_calls.microphone_title" : {
      "comment" : "Adds microphone selection only when virtual audio output is enabled.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select FaceNow as your microphone"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 FaceNow 作为麦克风"
          }
        }
      }
    },
    "guide.video_calls.microphone_detail" : {
      "comment" : "Names the stable virtual audio input to select in calling software.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In your calling app’s microphone menu, select “%1$@” to keep audio in sync with your FaceNow video."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在视频通话应用的麦克风菜单中选择“%1$@”，让声音与 FaceNow 画面保持同步。"
          }
        }
      }
    },
    "guide.allow_microphone_access" : {
      "comment" : "Requests system permission without starting audio capture.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Microphone Access"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许麦克风访问"
          }
        }
      }
    },
    "guide.microphone_introduction" : {
      "comment" : "Explains optional physical microphone input.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow FaceNow to capture your voice. You can choose an input device or turn the microphone off at any time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 FaceNow 使用麦克风采集声音。你可以随时选择输入设备或关闭麦克风。"
          }
        }
      }
    },
    "guide.microphone_restricted_title" : {
      "comment" : "Identifies microphone access restricted by system policy.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone Access Is Restricted"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问受限"
          }
        }
      }
    },
    "guide.microphone_restricted_detail" : {
      "comment" : "Explains restricted microphone access and optional continuation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access is restricted by macOS or your administrator. You can skip this step and continue with video."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 的麦克风权限受到系统或管理员限制。你可以跳过此步骤，继续使用视频功能。"
          }
        }
      }
    },
    "guide.microphone_settings_detail" : {
      "comment" : "Explains how to enable a previously denied microphone permission.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In System Settings → Privacy & Security → Microphone, enable FaceNow, then return here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置 → 隐私与安全性 → 麦克风”中开启 FaceNow，然后返回此处。"
          }
        }
      }
    },
    "guide.microphone_request_detail" : {
      "comment" : "Explains the explicit microphone permission prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click “Allow Microphone Access”, then choose Allow in the permission dialog."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击“允许麦克风访问”，然后在权限弹窗中选择“允许”。"
          }
        }
      }
    },
    "guide.microphone_step_ready" : {
      "comment" : "Confirms permission without claiming audio capture has started.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access is ready. Continue setup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风权限已开启。继续完成设置。"
          }
        }
      }
    },
    "step.state.skipped" : {
      "comment" : "Identifies an explicitly deferred optional step for accessibility.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "skipped"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
