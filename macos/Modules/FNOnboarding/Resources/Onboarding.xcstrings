        }
      }
    },
    "guide.camera_access_is_restricted_by_macos_or_a_device" : {
      "comment" : "Displayed text in Modules/FNOnboarding/MVVM/View/OnboardingGuideView.swift.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is restricted by macOS or a device-management policy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 或设备管理策略限制了摄像头访问。"
          }
        }
      }
    },
    "guide.camera_extension_permission_prompt_choose_open_system_settings" : {
      "comment" : "Displayed text in Modules/FNOnboarding/MVVM/View/OnboardingGuideView.swift.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera extension permission prompt. Choose Open System Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摄像头扩展权限弹窗。请选择“打开系统设置”。"
          }
        }
      }
    },
    "guide.camera_extensions_enable_facenow_then_click_done" : {
      "comment" : "Displayed text in Modules/FNOnboarding/MVVM/View/OnboardingGuideView.swift.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera Extensions. Enable FaceNow, then click Done."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机扩展。启用 FaceNow，然后点击“完成”。"
          }
        }
      }
