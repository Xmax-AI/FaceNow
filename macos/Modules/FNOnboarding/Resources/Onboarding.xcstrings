    "content.we_access_your_camera_in_accordance_with_our_terms" : {
      "comment" : "%1$@ is Terms of Use; %2$@ is Privacy Policy. Preserve both legal-link labels.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We access your camera and, when enabled, microphone in accordance with our %1$@ and %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们会依照《%1$@》和《%2$@》使用你的摄像头和麦克风。"
          }
        }
      }
    },
    "guide.allow_facenow" : {
      "comment" : "Displayed text in Modules/FNOnboarding/MVVM/View/OnboardingGuideView.swift.",
      "extractionState" : "manual",
      "localizations" : {
