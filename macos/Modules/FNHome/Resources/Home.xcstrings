    "about.cost.detail" : {
      "comment" : "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At a fraction of the price of competing products, it significantly lowers the cost of real-time video generation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "价格仅为竞品的几分之一，大幅降低实时视频生成成本。"
          }
        }
      }
    },
    "about.cost.metric" : {
