    "about.fidelity.detail" : {
      "comment" : "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faithfully reproduces the details and textures of characters and clothing, bringing generated results closer to the intended look and style."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高保真还原人物与服装的细节纹理，使生成结果更契合预期的形象与风格。"
          }
        }
      }
    },
    "about.fidelity.metric" : {
