    "about.latency.detail" : {
      "comment" : "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultra-low end-to-end latency brings movements and effects to the screen in real time, with fast startup and smooth effect switching."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "极低的端到端延迟，让动作与效果都能实时呈现，带来秒开秒换的流畅体验。"
          }
        }
      }
    },
    "about.latency.metric" : {
      "comment" : "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
