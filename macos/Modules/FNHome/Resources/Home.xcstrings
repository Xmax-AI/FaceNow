    "about.model_introduction" : {
      "comment" : "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xmax X2.1 is the real-time video generation model behind FaceNow and one of the world's leading general-purpose video editing models. It can reshape character appearances, outfits, and visual styles in real time, combining high-fidelity visuals with the fastest response and lowest usage costs in its class to make real-time video applications commercially viable at scale."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xmax X2.1 是 FaceNow 背后的实时视频生成模型，也是目前世界领先的通用视频编辑模型。它能够实时重塑视频中的人物形象、服装穿搭与视觉风格，在保持高保真画质的同时，兼具同类最快的响应速度与最低的使用成本，让实时视频应用的规模化商用成为可能。"
          }
        }
      }
    },
    "about.model_title" : {
      "comment" : "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meet Xmax X2.1"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "认识 Xmax X2.1"
          }
        }
      }
    },
    "about.partnership_detail" : {
      "comment" : "About Us modal. Product claims and pricing are supplied by the product owner.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beyond video meetings, Xmax X2.1 can power live streaming, virtual try-on for e-commerce, and other interactive video products. Related applications have received positive feedback at industry showcases and from partners. If you would like to integrate real-time video generation into your own app, contact us to learn about integration options and technical support."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了视频会议，Xmax X2.1 还可用于直播、电商试穿及其他视频互动产品，相关应用已在行业展示与合作伙伴中获得积极反馈。如果你希望将实时视频生成能力接入自己的应用，欢迎联系我们，了解接入方案与技术支持服务。"
          }
        }
      }
    },
    "about.partnership_title" : {
