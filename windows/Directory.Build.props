<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <FaceNowEdition Condition="'$(FaceNowEdition)' == ''">Domestic</FaceNowEdition>
    <FaceNowMediaDirectory Condition="'$(FaceNowMediaDirectory)' == ''">C:/dev/FaceNow-media</FaceNowMediaDirectory>
    <DefineConstants Condition="'$(FaceNowEdition)' == 'Overseas'">$(DefineConstants);FACENOW_OVERSEAS</DefineConstants>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <FaceNowBuildRoot Condition="'$(FaceNowBuildRoot)' == ''">$(MSBuildThisFileDirectory).build/dotnet/</FaceNowBuildRoot>
    <BaseOutputPath>$(FaceNowBuildRoot)bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(FaceNowBuildRoot)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <XmaxSdkVersion>1.1.4</XmaxSdkVersion>
    <XmaxSdkPackageSHA256>7be1f432e874725694982e682208785bc8fe4f475485e5350f9374213465f840</XmaxSdkPackageSHA256>
    <XmaxSdkWinUIPackageSHA256>82a26360f591a5fca30794dee1de032682ad78e6b358f6b243d61b9f25afe015</XmaxSdkWinUIPackageSHA256>
  </PropertyGroup>
</Project>
